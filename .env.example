# Supabase project URL and publishable key. Server-side only: never prefix with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Random secret sent as the x-app-key header. Its SHA-256 hash lives in private.app_secret.
# Generate with: openssl rand -hex 32
APP_KEY=

# Web push keys. Generate with: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services: the site's https URL or a mailto: address.
VAPID_SUBJECT=https://your-app.netlify.app

# Shared secret for the session reminder job (Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=
